# OAuth 2.0 (base de datos pública: buscar alimentos, recetas…)
FATSECRET_CLIENT_ID=tu_client_id
FATSECRET_CLIENT_SECRET=tu_client_secret
# Scopes separados por espacio: basic, premier, barcode, localization, nlp, image-recognition
FATSECRET_SCOPE=basic

# OAuth 1.0 (tu cuenta: diario, saved meals). La Consumer Key es el mismo Client ID;
# el Consumer Secret aparece aparte en Manage API Keys y NO es el Client Secret.
FATSECRET_CONSUMER_SECRET=tu_consumer_secret
